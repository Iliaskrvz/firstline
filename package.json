{
  "name": "firstline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked --schema public > src/lib/supabase/database.types.ts",
    "engine:try": "tsx scripts/try-engine.ts",
    "worker": "tsx worker/index.ts",
    "tunnel": "cloudflared tunnel --no-autoupdate --url http://localhost:3000"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@polar-sh/sdk": "^1.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "dotenv": "^18.0.10",
    "next": "16.4.5",
    "papaparse": "^5.7.0",
    "pg-boss": "^12.38.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^17.11.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "pg": "^8.23.1",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
