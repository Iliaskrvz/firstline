      "position": [
        200,
        0
      ],
      "parameters": {
        "resource": "credit",
        "operation": "get"
      },
      "credentials": {
        "firstLineApi": {
          "name": "FirstLine API"
        }
      }
    },
    {
      "id": "n2",
      "name": "Personalise",
      "type": "n8n-nodes-firstline-email.firstLine",
      "typeVersion": 1,
      "position": [
        400,
        0
      ],
      "parameters": {
        "resource": "lead",
        "operation": "personalize",
        "email": "sanne@bakkerijvos.nl",
