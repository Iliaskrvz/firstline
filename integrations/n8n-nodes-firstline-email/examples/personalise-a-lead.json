      "main": [
        [
          {
            "node": "Get job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "nodes": [
    {
      "id": "n0",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
