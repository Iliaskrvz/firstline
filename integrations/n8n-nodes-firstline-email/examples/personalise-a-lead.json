        "additionalFields": {
          "first_name": "Sanne",
          "company": "Bakkerij Vos",
          "website": "bakkerijvos.nl",
          "idempotencyKey": "={{ $execution.id }}"
        }
      },
      "credentials": {
        "firstLineApi": {
          "name": "FirstLine API"
        }
      }
    },
    {
      "id": "n3",
      "name": "Get job",
      "type": "n8n-nodes-firstline-email.firstLine",
      "typeVersion": 1,
      "position": [
        600,
        0
      ],
      "parameters": {
        "resource": "job",
        "operation": "get",
        "jobId": "={{ $json.id }}",
        "jobWait": 0
      },
      "credentials": {
        "firstLineApi": {
          "name": "FirstLine API"
        }
      }
    }
  ]
