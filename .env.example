# Copy to .env.local and fill in. Never commit real values.

# --- Phase 1 -------------------------------------------------------------
# Supabase → Project Settings → API (or "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public URL of this app (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 2+ (not needed yet) ---------------------------------------------
# Supabase secret key (sb_secret_...) / legacy service_role key. Server/worker only.
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=
GOOGLE_PLACES_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
