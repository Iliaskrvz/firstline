# Copy to .env.local and fill in. Never commit real values.

# --- Web app (Phase 1) ----------------------------------------------------
# Supabase → Project Settings → API (or "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Engine + worker (Phase 2) ----------------------------------------------
# Supabase → Connect → Session pooler (port 5432, NOT the 6543 transaction pooler).
# Used by the pg-boss job queue and the worker. Server-side only.
DATABASE_URL=
# Optional: path to Supabase's CA certificate (Database settings → SSL) to verify the DB server.
DATABASE_CA_CERT=
# firecrawl.dev → Dashboard → API Keys
FIRECRAWL_API_KEY=
# "fake" (default) = test output, no AI used. "deepseek" = DeepSeek writes (models per step:
# src/config/models.ts). "anthropic" = Claude writes (kept for switching back). That's the only switch.
LLM_PROVIDER=fake
# platform.deepseek.com → API keys. Only needed with LLM_PROVIDER=deepseek. Prepaid: top up there.
DEEPSEEK_API_KEY=
# Email the admins once a day while the DeepSeek balance is below this (in the balance's currency).
DEEPSEEK_BALANCE_ALERT=
# console.anthropic.com → Settings → API Keys. Only needed with LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# --- Gmail sender (Phase 3) -------------------------------------------------
# The public https address the Sender Sheet script calls. Google can't reach localhost:
# in development run `npm run tunnel` and paste the https://….trycloudflare.com address here.
PUBLIC_APP_URL=

# --- Admin (Phase 6) -------------------------------------------------------------
# Comma-separated emails that may open /admin (margin dashboard, Quality Lab, sender switch).
ADMIN_EMAILS=
# For showing USD costs in euro on the admin page.
USD_EUR_RATE=0.92

# Optional tuning
WORKER_CONCURRENCY=10
WORKSPACE_CONCURRENCY=5
# Requests to Firecrawl at once per worker. The worker also caps this at your plan's limit
# (Firecrawl reports it: Free/Hobby plans allow 2).
FIRECRAWL_CONCURRENCY=5
# AI requests at once across all workers (old name ANTHROPIC_CONCURRENCY still works)
LLM_CONCURRENCY=5
# List price per Firecrawl credit used for cost logging (Standard plan: 0.00083)
FIRECRAWL_USD_PER_CREDIT=0.00083
WORKER_HEALTH_PORT=8787

# --- Later phases -------------------------------------------------------------
SUPABASE_SECRET_KEY=
GOOGLE_PLACES_API_KEY=
# --- Payments: Polar (merchant of record: handles VAT and invoices) ----------------------
# polar.sh/dashboard/first-line/settings → Developers → New token (production). Save with: bash scripts/set-env.sh POLAR_ACCESS_TOKEN
POLAR_ACCESS_TOKEN=
# Signing secret of the webhook endpoint https://<your address>/api/webhook/polar
POLAR_WEBHOOK_SECRET=
# production or sandbox
POLAR_SERVER=production
# Polar product id per pack on sale (scripts/polar-setup.ts --packs creates the products and fills these)
POLAR_PRODUCT_STARTER=
POLAR_PRODUCT_GROWTH=
POLAR_PRODUCT_AGENCY=
# Inbox-offline alert emails (Phase 4). resend.com → API Keys. Without it, offline inboxes only show in the app.
RESEND_API_KEY=
# A sender on a domain verified in Resend. The default onboarding@resend.dev only delivers to your Resend account's own email.
ALERT_FROM_EMAIL=

# Legal pages (privacy, terms, DPA). Empty = shown as "[to be completed]" with a draft notice.
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_KVK=
LEGAL_VAT=
LEGAL_EMAIL=
LEGAL_HOST_NAME=
LEGAL_HOST_LOCATION=

# Sending-tool integrations (Phase 7). 32 random bytes, base64: bash scripts/gen-secret.sh INTEGRATIONS_ENCRYPTION_KEY
# Encrypts customer API keys at rest. Never change it once keys are saved. Same value locally and on the VPS (shared database).
INTEGRATIONS_ENCRYPTION_KEY=
# Allow "fake-…" integration keys in production (click-through without a real account). Off by default.
INTEGRATIONS_ALLOW_FAKE=

# Phase 10: scale and packs
# Worker processes under pm2 (limits per provider and per workspace are shared in Postgres).
WORKER_INSTANCES=1
# AI requests per minute across all workers (old name ANTHROPIC_RPM still works). DeepSeek has no
# per-minute limit, only a concurrency limit; set this to keep spend steady. Empty = no limit of ours.
LLM_RPM=
# Provider budgets on /admin, alerts at 80% and 100%.
# Firecrawl's credits left come from Firecrawl itself; AI spend is our own cost log vs this monthly cap in USD
# (old name ANTHROPIC_MONTHLY_CAP_USD still works).
LLM_MONTHLY_CAP_USD=
# Packs on sale (ids from src/config/packs.ts). Empty = the config's "enabled" ones (starter, growth, agency).
PACKS_ENABLED=
# Polar product id per pack (scripts/polar-setup.ts --packs fills these): POLAR_PRODUCT_SCALE_50K=..., POLAR_PRODUCT_LITE_50K=...

# Phase 11: Deep research is built but OFF. Leave this empty until the lawyer has answered the
# questions in docs/legal-drafts/deep.md and the AI provider's terms allow it (see docs/legal-drafts/deepseek.md).
# Deep is not available with LLM_PROVIDER=deepseek at all: it would need the contact's name.
DEEP_RESEARCH_ENABLED=
