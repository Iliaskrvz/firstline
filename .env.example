# Copy to .env.local and fill in. Never commit real values.

# --- Web app (Phase 1) ----------------------------------------------------
# Supabase → Project Settings → API (or "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Engine + worker (Phase 2) ----------------------------------------------
# Supabase → Connect → Session pooler (port 5432, NOT the 6543 transaction pooler).
# Used by the pg-boss job queue and the worker. Server-side only.
DATABASE_URL=
# Optional: path to Supabase's CA certificate (Database settings → SSL) to verify the DB server.
DATABASE_CA_CERT=
# firecrawl.dev → Dashboard → API Keys
FIRECRAWL_API_KEY=
# "fake" (default) = test output, no AI used. "anthropic" = Claude writes. That's the only switch.
LLM_PROVIDER=fake
# console.anthropic.com → Settings → API Keys. Only needed with LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# --- Gmail sender (Phase 3) -------------------------------------------------
# The public https address the Sender Sheet script calls. Google can't reach localhost:
# in development run `npm run tunnel` and paste the https://….trycloudflare.com address here.
PUBLIC_APP_URL=

# Optional tuning
WORKER_CONCURRENCY=10
WORKSPACE_CONCURRENCY=5
# Requests to Firecrawl at once per worker. The worker also caps this at your plan's limit
# (Firecrawl reports it: Free/Hobby plans allow 2).
FIRECRAWL_CONCURRENCY=5
ANTHROPIC_CONCURRENCY=5
# List price per Firecrawl credit used for cost logging (Standard plan: 0.00083)
FIRECRAWL_USD_PER_CREDIT=0.00083
WORKER_HEALTH_PORT=8787

# --- Later phases -------------------------------------------------------------
SUPABASE_SECRET_KEY=
GOOGLE_PLACES_API_KEY=
# --- Payments (Phase 5): Kelviq (merchant of record: handles VAT and invoices) ---------
# app.kelviq.com → Settings → API keys: the Server API key, from the same mode as KELVIQ_ENV.
KELVIQ_API_KEY=
# sandbox (test payments, default) or production
KELVIQ_ENV=sandbox
# Settings → Webhooks → endpoint https://<your address>/api/kelviq/webhook, event checkout.completed → secret (kq_whsec_…)
KELVIQ_WEBHOOK_SECRET=
# One-time plans per pack in the Kelviq catalog (defaults below)
KELVIQ_PLAN_STARTER=firstline-starter
KELVIQ_PLAN_GROWTH=firstline-growth
KELVIQ_PLAN_AGENCY=firstline-agency
# Inbox-offline alert emails (Phase 4). resend.com → API Keys. Without it, offline inboxes only show in the app.
RESEND_API_KEY=
# A sender on a domain verified in Resend. The default onboarding@resend.dev only delivers to your Resend account's own email.
ALERT_FROM_EMAIL=
